# Copy to .env. Nothing here is a real secret; the production values are
# rendered by the Infisical agent (deploy/infisical/README.md).

# -- database ----------------------------------------------------------------
CATALOGUE_DB_NAME=ateliera
CATALOGUE_DB_USER=catalogue
CATALOGUE_DB_PASSWORD=catalogue
CATALOGUE_CONTROL_DB_PASSWORD=catalogue-control
CATALOGUE_WORKER_DB_PASSWORD=catalogue-worker
CATALOGUE_PROXY_ARCHIVE_DB_PASSWORD=catalogue-proxy-archive
# Loopback only. 5434 keeps it clear of the application stack on 5433 and of any
# system PostgreSQL on 5432.
CATALOGUE_DB_PORT=5434

# One provider is active for the entire environment. NATS is the local default.
CATALOGUE_QUEUE_PROVIDER=nats
CATALOGUE_QUEUE_POLL_EMPTY_SECONDS=2
CATALOGUE_QUEUE_VISIBILITY_SECONDS=4200

# NATS JetStream work delivery. Local Compose runs it unauthenticated on its
# private network and loopback ports; production uses the role-specific
# credential files documented in docs/queue-provider-runbook.md.
CATALOGUE_NATS_PORT=4222
CATALOGUE_NATS_MONITOR_PORT=8222

# Cloudflare Queues. Set these only when CATALOGUE_QUEUE_PROVIDER=cloudflare;
# the five token files are separate least-privilege credentials.
CATALOGUE_CF_ACCOUNT_ID=
CATALOGUE_CF_QUEUE_PLAIN_ID=
CATALOGUE_CF_QUEUE_BROWSER_AUTO_ID=
CATALOGUE_CF_QUEUE_BROWSER_CAMOUFOX_ID=
CATALOGUE_CF_QUEUE_BROWSER_CDP_EXTENSION_PROXY_ID=
CATALOGUE_CF_QUEUE_RECOVERY_DLQ_ID=
CATALOGUE_CF_PUBLISH_TOKEN_FILE=/dev/null
CATALOGUE_CF_CONSUME_TOKEN_FILE=/dev/null
CATALOGUE_CF_RECOVERY_TOKEN_FILE=/dev/null
CATALOGUE_CF_STATS_TOKEN_FILE=/dev/null
CATALOGUE_CF_ADMIN_TOKEN_FILE=/dev/null

# -- control plane -----------------------------------------------------------
# Required. catalogue-control refuses to start without it, and compose refuses
# to render without it, because an unauthenticated service that can cancel runs
# and disable sources is worse than not having one.
#
#   openssl rand -hex 32
CATALOGUE_CONTROL_TOKEN=

# Paid-proxy control is fail-closed. Leave these false until the database
# migration, actor keys, Decodo unit check, active cycle, and reconciliation
# have all been completed in that order.
CATALOGUE_PROXY_ENABLED=false
CATALOGUE_PROXY_MUTATIONS_ENABLED=false
CATALOGUE_PROXY_PAID_PROBE_ENABLED=false
# Webshare gateway credentials bootstrap a control-owned private store. Control
# alone may replace generations; workers mount the store read-only. Leave the
# seed at /dev/null and the independent gate false by default. A mounted
# credential alone never enables paid traffic.
CATALOGUE_WEBSHARE_GATEWAY_SECRET_SOURCE=/dev/null
CATALOGUE_PROXY_WEBSHARE_DATA_PLANE_ENABLED=false
# Decodo's public schema does not state the unit of traffic_limit. Change this
# only after the subscription value is compared with the dashboard's 3 GB.
CATALOGUE_PROXY_PROVIDER_LIMIT_UNIT=unconfirmed

# Generate these with scripts/generate-proxy-operator-keys.py. The private key
# belongs only in explorer; control gets only the public-key JSON.
CATALOGUE_OPERATOR_PUBLIC_KEYS_FILE=deploy/secrets/operator-public-keys.json
CATALOGUE_OPERATOR_PRIVATE_KEY_FILE=deploy/secrets/operator-private-key.pem
CATALOGUE_OPERATOR_ASSERTION_KEY_ID=current
# This defaults to Cloudflare Access's authenticated email header. Caddy or any
# other identity-aware proxy can supply a different trusted header name.
CATALOGUE_OPERATOR_ID_HEADER=cf-access-authenticated-user-email
# The trusted access layer must inject a Unix timestamp for the last primary or
# step-up authentication. Provider writes and paid enablement require <=10 min.
CATALOGUE_OPERATOR_AUTH_TIME_HEADER=x-catalogue-auth-time
CATALOGUE_OPERATOR_ADMINS=
CATALOGUE_OPERATOR_VIEWERS=

# -- response cache archive --------------------------------------------------
# The golden tests replay the recorded cache, so it is a build input and lives
# in R2 rather than in the tree. `push` needs a key that can write the bucket;
# `pull` needs one that can only read it. The keys themselves come from the
# environment (the agent renders them; CI reads them from Infisical) and never
# from the command line.
CATALOGUE_CACHE_BUCKET=makersbrain-catalogue-cache
CATALOGUE_CACHE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -- explorer ----------------------------------------------------------------
CATALOGUE_UI_PORT=5175

# -- tracing (optional) ------------------------------------------------------
# The SDK is always wired; spans are only exported when this is set. There is no
# collector in the deployment yet, which is why it is empty: what ships today is
# the trace_id on each job row and in every log line, so the correlation exists
# in the data and a collector added later reads history rather than starting
# from zero.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
