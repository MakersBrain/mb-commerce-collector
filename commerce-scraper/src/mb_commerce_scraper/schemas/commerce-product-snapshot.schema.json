{
  "$defs": {
    "Availability": {
      "enum": [
        "in_stock",
        "out_of_stock",
        "backorder",
        "preorder",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "CategoryRef": {
      "additionalProperties": false,
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "CategoryRef",
      "type": "object"
    },
    "CommerceOffer": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Availability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Availability Evidence",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "minimum_quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Quantity"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "pack_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Size"
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "role": {
          "default": "regular",
          "enum": [
            "regular",
            "sale",
            "member",
            "quantity_tier"
          ],
          "title": "Role",
          "type": "string"
        },
        "seller_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seller Id"
        },
        "seller_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seller Name"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "vat_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vat Rate"
        },
        "vat_status": {
          "default": "unknown",
          "enum": [
            "inclusive",
            "exclusive",
            "unknown"
          ],
          "title": "Vat Status",
          "type": "string"
        }
      },
      "required": [
        "price",
        "observed_at",
        "evidence"
      ],
      "title": "CommerceOffer",
      "type": "object"
    },
    "CommerceVariant": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "external_id": {
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "gtin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gtin"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_default": {
          "default": false,
          "title": "Is Default",
          "type": "boolean"
        },
        "offers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CommerceOffer"
          },
          "title": "Offers",
          "type": "array"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Options",
          "type": "object"
        },
        "platform_extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Platform Extensions",
          "type": "object"
        },
        "published_attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Published Attributes",
          "type": "object"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "stock": {
          "anyOf": [
            {
              "$ref": "#/$defs/StockState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "external_id"
      ],
      "title": "CommerceVariant",
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "external_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "media_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "observed_at",
        "evidence"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "published",
          "enum": [
            "published",
            "verified",
            "derived"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "method": {
          "enum": [
            "api",
            "jsonld",
            "microdata",
            "opengraph",
            "html",
            "cart_ceiling",
            "browser"
          ],
          "title": "Method",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "method",
        "source_url",
        "observed_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {},
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Text"
        },
        "external_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "media_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "StockQuantityKind": {
      "enum": [
        "exact",
        "lower_bound",
        "upper_bound",
        "order_limit",
        "unknown"
      ],
      "title": "StockQuantityKind",
      "type": "string"
    },
    "StockState": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "quantity_kind": {
          "$ref": "#/$defs/StockQuantityKind",
          "default": "unknown"
        }
      },
      "required": [
        "availability",
        "observed_at",
        "evidence"
      ],
      "title": "StockState",
      "type": "object"
    }
  },
  "$id": "https://makersbrain.com/schemas/mb-commerce-scraper/v1/commerce-product-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_url": {
      "minLength": 1,
      "title": "Canonical Url",
      "type": "string"
    },
    "categories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CategoryRef"
      },
      "title": "Categories",
      "type": "array"
    },
    "connector": {
      "minLength": 1,
      "title": "Connector",
      "type": "string"
    },
    "contract_version": {
      "const": "commerce.product_snapshot.v1",
      "default": "commerce.product_snapshot.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentRef"
      },
      "title": "Documents",
      "type": "array"
    },
    "external_id": {
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "images": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MediaRef"
      },
      "title": "Images",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "platform_extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Platform Extensions",
      "type": "object"
    },
    "published_attributes": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Published Attributes",
      "type": "object"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Updated At"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "variants": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CommerceVariant"
      },
      "title": "Variants",
      "type": "array"
    },
    "vendor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vendor"
    }
  },
  "required": [
    "connector",
    "source_id",
    "external_id",
    "canonical_url",
    "title",
    "observed_at"
  ],
  "title": "CommerceProductSnapshot",
  "type": "object"
}
