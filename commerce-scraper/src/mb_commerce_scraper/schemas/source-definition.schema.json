{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "https://makersbrain.com/schemas/mb-commerce-scraper/v1/source-definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "pattern": "^https?://",
      "title": "Base Url",
      "type": "string"
    },
    "connector": {
      "minLength": 1,
      "title": "Connector",
      "type": "string"
    },
    "connector_options": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Connector Options",
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "base_url",
    "connector"
  ],
  "title": "SourceDefinition",
  "type": "object"
}
