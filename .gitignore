# Python environments and build output
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
*.egg-info/

# Node
node_modules/
.svelte-kit/
catalogue-explorer/build/
*.tsbuildinfo

# The recorded response cache. 638 MB of gzipped pages, and the golden tests
# replay it. It is published to R2 as a versioned tarball and fetched with
# `catalogue-cache-archive pull`; catalogue-dump/cache-archive.json names the
# archive each commit expects. Committing it as ordinary blobs would put most of
# a gigabyte into every clone, and Git LFS bills bandwidth on every fetch.
catalogue-dump/.cache/

# Collected catalogues. These are outputs, and the ones that matter are already
# loaded into catalogue.offer_observations.
catalogue-dumps*/
catalogue-dump/catalogue-dumps*/
dumps/
backups/*.dump
backups/*.dump.*
*.ndjson

# The golden files are the exception: they are small, they are checked in on
# purpose, and the diff on one is the review of a behaviour change.
!catalogue-dump/tests/golden/*.json

# Scraped product images (212 MB across 2,217 files) and the supplier brochures
# they were extracted from. Derived from public catalogues and re-fetchable, so
# they are kept out of history rather than in it — a repository nobody can clone
# on a slow connection is a repository nobody clones. Track them with Git LFS or
# an object store if they need to be shared.
catalogue-images/
*.pdf

# Local state
*.sqlite
*.sqlite3
.env

# Connector tokens and anything else handed to a container as a file rather
# than an environment variable. Real credentials, mode 0600, never in history.
deploy/secrets/

# Decodo dashboard endpoint exports contain plaintext proxy credentials.
decodo.csv
decodo.env

# Observability credentials (copy the .example files; values from Infisical)
deploy/observability/vmagent.env
deploy/observability/vmalert.env
