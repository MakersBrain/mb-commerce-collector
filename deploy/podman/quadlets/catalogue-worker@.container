[Unit]
Description=Ceramics catalogue worker %i
Requires=catalogue-nats.container
After=catalogue-nats.container

[Container]
Image=@@WORKER_IMAGE@@
Pull=never
ContainerName=catalogue-worker-%i
Network=catalogue.network
UserNS=keep-id:uid=10001,gid=10001
User=10001
Group=10001
EnvironmentFile=/etc/makersbrain/catalogue/worker.env
Environment=CATALOGUE_NATS_URL=nats://catalogue-nats:4222
Environment=CATALOGUE_NATS_CONSUME_CREDENTIALS_FILE=/run/queue/nats-consume-credentials.json
Volume=/etc/makersbrain/catalogue-secrets/nats-consume-credentials.json:/run/queue/nats-consume-credentials.json:ro
Volume=/etc/makersbrain/catalogue-secrets/webshare-gateway.json:/run/secrets/webshare-gateway.json:ro
Volume=/etc/makersbrain/tenant-runtime-secrets/postgres-ca.crt:/run/database/postgres-ca.crt:ro
Volume=catalogue-cache.volume:/var/lib/catalogue/cache
Volume=catalogue-dumps.volume:/var/lib/catalogue/dumps
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9109/health')"
HealthInterval=30s
HealthStartPeriod=15s
HealthRetries=3
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillSignal=SIGTERM

[Install]
WantedBy=default.target
