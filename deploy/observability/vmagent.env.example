# Copy to vmagent.env. Values come from Infisical /observability, owned by
# Mazenet -- see docs/contracts/makersbrain-observability.md in mb-infra.
# Never commit the real file.
#
# Read by vmagent via --envflag.enable: a flag -foo.bar reads env foo_bar.
# Credentials stay out of the container command line this way; mb-infra's
# podman unit goes further and mounts them as 0600 files an entrypoint reads.

# The exact HTTPS /api/v1/write endpoint. VictoriaMetrics serves the same
# Prometheus remote-write path, so this value is unchanged by the plane's
# Prometheus-to-VictoriaMetrics swap.
remoteWrite_url=https://metrics-ingest.mazenet.org/api/v1/write

# Cloudflare Access service token. Multiple headers are separated by ^^.
remoteWrite_headers=CF-Access-Client-Id: REPLACE_ME^^CF-Access-Client-Secret: REPLACE_ME
