# Copy to vmalert.env. Never commit the real file.
#
# BLOCKED: the active contract (revision 2026-08-25.1) authorizes the vmagent
# token for /api/v1/write and nothing else. It states that ALERTMANAGER_URL and
# its token pair are "a provisioned future interface, not part of this active
# contract", and it grants no query-API read path at all. All three URLs below
# need a contract revision applied to BOTH copies -- mb-infra and mazenet-infra
# -- before this service can start.

# Where vmalert reads the series its rules evaluate: the plane's store, which
# is where this deployment's own vmagent writes. Needs a new authorized read
# path; no such hostname exists in the contract today.
datasource_url=https://REPLACE_ME.mazenet.org
datasource_headers=CF-Access-Client-Id: REPLACE_ME^^CF-Access-Client-Secret: REPLACE_ME

# ALERTS and ALERTS_FOR_STATE round-trip, so restarts do not reset `for:` timers.
remoteWrite_url=https://metrics-ingest.mazenet.org/api/v1/write
remoteWrite_headers=CF-Access-Client-Id: REPLACE_ME^^CF-Access-Client-Secret: REPLACE_ME
remoteRead_url=https://REPLACE_ME.mazenet.org
remoteRead_headers=CF-Access-Client-Id: REPLACE_ME^^CF-Access-Client-Secret: REPLACE_ME

# Delivery. The plane's Alertmanager, reached directly per the contract's
# provisioned-future-interface section.
notifier_url=https://alertmanager.mazenet.org
notifier_headers=CF-Access-Client-Id: REPLACE_ME^^CF-Access-Client-Secret: REPLACE_ME

# Alert annotations link back here.
external_url=https://alertmanager.mazenet.org
